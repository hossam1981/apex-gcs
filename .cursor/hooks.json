{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "python3 .cursor/hooks/validate-on-edit.py",
        "timeout": 30
      }
    ],
    "afterTabFileEdit": [
      {
        "command": "python3 .cursor/hooks/validate-on-edit.py",
        "timeout": 30
      }
    ],
    "stop": [
      {
        "command": "python3 .cursor/hooks/validate-on-stop.py",
        "timeout": 30,
        "loop_limit": 3
      }
    ]
  }
}
